      "color": "#ff865c"
    }
  ],
  "colons": [
    {
      "name": "Stock colon",
      "cost": 0,
      "duration": 0.8
    },
    {
      "name": "Extended colon",
      "cost": 5,
      "duration": 1.5
    },
